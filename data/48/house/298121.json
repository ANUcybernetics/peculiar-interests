  {
   "category": "gifts",
   "fields": {
    "details": "Cost: The total cost of the program is $32,000 (plus GST)."
   },
   "holder": "self",
   "source_id": null
  },
  {
   "category": "gifts",
   "fields": {
    "details": "This covers full scholarship funded by the McKinnon Institute, covering the costs of tuition, induction, residential intensive and workshop (accommodation for 7-9 nights) and all meals and refreshments."
   },
   "holder": "self",
   "source_id": null
  },
  {
   "category": "gifts",
   "fields": {
    "details": "Advanced Political Leadership is a cohort based, face-to-face program designed to help you prepare for ministerial life, and enhance impact and influence through your career. This program challenges participants to lead effectively, legitimately and with an understanding of their democratic stewardship responsibilities. It has been developed with insights from experienced and successful political leaders, and evolved with detailed feedback from past participants. The curriculum is practical and applied, and challenges participants to prepare for their future roles through a combination of self-reflection, structured small group work and whole-of-cohort dialogues."
   },
   "holder": "self",
   "source_id": null
  },
