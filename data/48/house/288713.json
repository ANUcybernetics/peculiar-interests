  {
   "category": "travel-hospitality",
   "date_processed": "2026-11-16",
   "date_submitted": "2026-11-16",
   "details": "The Global TB Caucus (GTBC) is a global network of parliamentarians uniting across borders and ideologies to drive political action, change policies, and secure funding – to protect the health of everyone, everywhere and end TB. With members in 44 out of 48 high TB burden countries, 18 G20 nations, and national TB caucuses in 58 countries, we work alongside civil society and global partners to keep TB where it belongs – at the top of the political agenda.",
   "fields": {},
   "holder": "self",
   "kind": "addition",
   "sequence": 28,
   "source_id": null
  },
  {
   "category": "travel-hospitality",
   "date_processed": "2026-11-16",
   "date_submitted": "2026-11-16",
   "details": "The Global Health Caucus (GHC) is an umbrella organisation, bringing together existing parliamentary networks (including GTBC) and seeding new ones to keep health high on the political agenda and translate commitments into action.",
   "fields": {},
   "holder": "self",
   "kind": "addition",
   "sequence": 29,
   "source_id": null
  },
  {
   "category": "travel-hospitality",
   "date_processed": "2026-11-16",
   "date_submitted": "2026-11-16",
   "details": "Both GTBC and GHC are hosted by a UK registered charity, Campaigns in Global Health.",
   "fields": {},
   "holder": "self",
   "kind": "addition",
   "sequence": 30,
   "source_id": null
  }
