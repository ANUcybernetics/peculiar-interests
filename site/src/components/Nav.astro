---
import { withBase } from "@/lib/paths";

const links = [
  { href: "/people", label: "People" },
  { href: "/items", label: "Items" },
  { href: "/mentions", label: "Mentions" },
  { href: "/changes", label: "Changes" },
  { href: "/search", label: "Search" },
  { href: "/data", label: "Data" },
  { href: "/about", label: "About" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
function isCurrent(href: string): boolean {
  const target = withBase(href).replace(/\/$/, "");
  return current === target || current.startsWith(`${target}/`);
}
---

<header class="masthead page">
  <a class="wordmark" href={withBase("/")}>Peculiar Interests</a>
  <nav aria-label="Site">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={withBase(l.href)} aria-current={isCurrent(l.href) ? "page" : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5) var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  .wordmark {
    font-weight: 800;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
</style>
