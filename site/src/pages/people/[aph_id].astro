---
import ChamberMark from "@/components/ChamberMark.astro";
import IdentityBlock from "@/components/IdentityBlock.astro";
import ItemBlock from "@/components/ItemBlock.astro";
import Layout from "@/components/Layout.astro";
import Ledger from "@/components/Ledger.astro";
import SourceBox from "@/components/SourceBox.astro";
import { dataset } from "@/lib/data";
import { buildLedger } from "@/lib/derive";
import { fullName, pluralise } from "@/lib/format";
import { CATEGORIES } from "@/lib/schema";

export function getStaticPaths() {
  return dataset().statements.map((s) => ({ params: { aph_id: s.aph_id } }));
}

const { aph_id } = Astro.params;
const { byId, personById } = dataset();
const s = byId.get(aph_id!)!;
const person = personById.get(s.aph_id);
const name = fullName(s.given_names, s.family_name);
const title = s.honorific && /hon/i.test(s.honorific) ? `${name}` : name;
const ledger = buildLedger([s]);
const pending = s.extraction.method === "pending";
const unreviewed = s.extraction.method === "ocr";
const description = `${name}'s register of interests: ${pluralise(s.interests.length, "declared item")} and ${pluralise(s.alterations.length, "alteration")}.`;
---

<Layout title={title} description={description}>
  <header class="head">
    <p class="head__kicker">
      Register of <ChamberMark chamber={s.chamber} form="member" />s' Interests, {s.parliament}th Parliament
    </p>
    <h1>{name}</h1>
  </header>

  <IdentityBlock statement={s} person={person} />

  {
    pending && (
      <div class="notice">
        <p>
          <strong>This scanned statement is awaiting transcription.</strong>
          You can read the official document using the link below.
        </p>
      </div>
    )
  }
  {
    unreviewed && (
      <div class="notice">
        <p>
          <strong>This transcription has not yet been checked by a person.</strong>
          Claude read it from a scanned document. Check entries against the official document linked below before using them.
        </p>
      </div>
    )
  }
  {s.notes.length > 0 && <div class="notice">{s.notes.map((n) => <p>{n}</p>)}</div>}

  {
    !pending && (
      <section class="items">
        <h2 id="statement">Statement of registrable interests</h2>
        <p class="muted small">
          Entries follow the fourteen categories on the declaration form.{" "}
          {s.chamber === "house"
            ? "Each row says whose interest it is: the member's own, their spouse or partner's, or a dependent child's."
            : "The Senate publishes the senator's own interests. Declarations for partners and dependent children are confidential to the Committee of Senators' Interests."}
        </p>
        <div class="items__list">
          {CATEGORIES.map((c) => (
            <ItemBlock
              category={c}
              interests={s.interests.filter((i) => i.category === c)}
              showHolder={s.chamber === "house"}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="section">
    <h2 id="alterations">Alterations</h2>
    {
      ledger.length === 0 ? (
        <p class="muted">No alterations notified since the statement was lodged.</p>
      ) : (
        <>
          <p class="muted small">
            {`${pluralise(ledger.length, "change")} notified since lodgement, newest first.`}
            A plus marks an addition; a minus marks a deletion. Details use the wording of the declaration.
          </p>
          <Ledger entries={ledger} showPerson={false} />
        </>
      )
    }
  </section>

  <SourceBox statement={s} />
</Layout>

<style>
  .head {
    padding-top: var(--space-6);
  }

  .head__kicker {
    color: var(--muted);
    margin-bottom: var(--space-2);
  }

  .items {
    container-type: inline-size;
  }

  .items__list {
    border-bottom: 1px solid var(--rule);
  }
</style>
