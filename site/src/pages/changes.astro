---
import Layout from "@/components/Layout.astro";
import Ledger from "@/components/Ledger.astro";
import { dataset } from "@/lib/data";
import { pluralise } from "@/lib/format";

const { ledger } = dataset();
const additions = ledger.filter((e) => e.alteration.kind === "addition").length;
---

<Layout title="Changes" description="Changes recorded in MPs' and senators' declarations, newest first.">
  <h1>Changes to declarations</h1>
  <p class="prose muted">
    {`${pluralise(ledger.length, "alteration")} across both chambers: ${additions} additions and ${ledger.length - additions} deletions, newest first.`}
    Dates show when a notice was processed, where recorded, or when it was submitted.
  </p>
  <Ledger entries={ledger} byMonth />
</Layout>
