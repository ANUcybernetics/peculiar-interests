---
import Layout from "@/components/Layout.astro";
import { withBase } from "@/lib/paths";
---

<Layout title="Not found">
  <div class="prose">
    <h1>Nothing declared here</h1>
    <p>
      There is no page at this address. Try the <a href={withBase("/people")}>list of people</a>, the
      <a href={withBase("/items")}>fourteen items</a>, or <a href={withBase("/search")}>search</a>.
    </p>
  </div>
</Layout>
