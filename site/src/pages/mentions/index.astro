---
import Layout from "@/components/Layout.astro";
import { dataset } from "@/lib/data";
import { mentionPeople } from "@/lib/derive";
import { pluralise } from "@/lib/format";
import { mentionPath } from "@/lib/paths";
import { CATEGORY_INFO } from "@/lib/schema";

const { mentions } = dataset();
const shared = mentions.filter((m) => mentionPeople(m) >= 2);
const single = mentions.length - shared.length;
---

<Layout title="Mentions" description="Companies, banks, trusts and other organisations named in declarations, and the politicians who declared them.">
  <h1>Names in the register</h1>
  <p class="prose muted">
    Find which politicians declared an interest in a company, bank, trust or other organisation.
    Names come from the organisation fields in statements and are grouped by spelling; different names may refer to the same organisation.
    Gift and travel descriptions are available through search.
    {`${pluralise(shared.length, "name appears", "names appear")} in two or more politicians' statements; ${single.toLocaleString("en-AU")} appear in one politician's statement each.`}
  </p>
  <div class="table-scroll">
    <table>
      <caption class="visually-hidden">Names in the register and who declared them</caption>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col" class="num">People</th>
          <th scope="col" class="num">Line items</th>
          <th scope="col">Category</th>
        </tr>
      </thead>
      <tbody>
        {
          mentions.map((m) => (
            <tr>
              <td>
                <a href={mentionPath(m.slug)}>{m.name}</a>
              </td>
              <td class="num">{mentionPeople(m)}</td>
              <td class="num">{m.rows.length}</td>
              <td class="muted small">
                {[...new Set(m.rows.map((r) => CATEGORY_INFO[r.category].short))].join(", ")}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Layout>
